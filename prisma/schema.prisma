// THE BUNKER — database schema.
// Change it with `npm run migrate:dev` (prisma migrate dev). Never use `prisma db push`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A guest (no email) or registered player.
model Player {
  id           String         @id @default(cuid())
  email        String?        @unique
  passwordHash String?
  displayName  String?
  /// player | admin. Accounts listed in ADMIN_EMAILS are also admins.
  role         String         @default("player")
  /// Stripe billing (set by the webhook). Membership = subStatus "active" or "trialing".
  stripeCustomerId String?    @unique
  /// Public share page /p/<shareCode>; null = not shared.
  shareCode    String?        @unique
  /// Pi Network identity (Pi edition). Set only from a token verified with Pi's /v2/me.
  piUid        String?        @unique
  piUsername   String?
  /// Set when this Pioneer completed the optional Pi supporter payment.
  piSupporterAt DateTime?
  piPayments   PiPayment[]
  subStatus    String?
  subInterval  String?
  subPeriodEnd DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  attempts     RoomAttempt[]
  progress     RoomProgress[]
  resetTokens  PasswordResetToken[]
  revisionsAuthored ContentRevision[] @relation("author")
  revisionsReviewed ContentRevision[] @relation("reviewer")
  signoffs     ContentSignoff[]
}

/// Every finished playthrough of a room, scored on the server.
model RoomAttempt {
  id             String   @id @default(cuid())
  playerId       String
  player         Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  roomId         String
  score          Int
  passed         Boolean
  criticalErrors Int
  breakdown      Json
  answers        Json
  createdAt      DateTime @default(now())

  @@index([playerId, roomId])
}

/// Best result per player per room. Drives unlocking.
model RoomProgress {
  playerId     String
  player       Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  roomId       String
  bestScore    Int
  passed       Boolean
  attempts     Int
  lastPlayedAt DateTime
  passedAt     DateTime?

  @@id([playerId, roomId])
}

/// One-time password reset link. Only the SHA-256 hash of the token is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  playerId  String
  player    Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([playerId, createdAt])
}

/// A proposed text change to room or scenario content. Only approved revisions reach players.
/// This table is also the audit log of every content change.
model ContentRevision {
  id           String    @id @default(cuid())
  contentId    String    // room id or scenario id
  path         String    // e.g. "items.3.ht.1"
  oldValue     String
  newValue     String
  note         String?
  status       String    @default("pending") // pending | approved | rejected
  authorId     String
  author       Player    @relation("author", fields: [authorId], references: [id])
  reviewerId   String?
  reviewer     Player?   @relation("reviewer", fields: [reviewerId], references: [id])
  selfApproved Boolean   @default(false)
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?

  @@index([contentId, status])
}

/// Expert sign-off that a room's content was reviewed (shown to players with the date).
model ContentSignoff {
  id         String   @id @default(cuid())
  contentId  String
  reviewerId String
  reviewer   Player   @relation(fields: [reviewerId], references: [id])
  reviewerName String
  note       String?
  createdAt  DateTime @default(now())

  @@index([contentId, createdAt])
}

/// Failed sign-ins, to slow down password guessing. Old rows can be deleted any time.
model AuthAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// Funnel events: a visitor started or finished a room / level (anonymous visitor id, no personal data).
model PlayEvent {
  id        String   @id @default(cuid())
  visitor   String
  playerId  String?
  /// start | finish
  kind      String
  contentId String
  /// 2d | 3d | level
  mode      String
  /// phone | desktop
  device    String
  createdAt DateTime @default(now())

  @@index([contentId, kind, createdAt])
  @@index([visitor, createdAt])
}

/// Pi Network payments (Pi edition). Mirrors Pi's own record; the server approves and completes them.
model PiPayment {
  id        String   @id @default(cuid())
  paymentId String   @unique
  playerId  String?
  player    Player?  @relation(fields: [playerId], references: [id], onDelete: SetNull)
  piUid     String
  amount    Float
  kind      String
  /// approved | completed | cancelled
  status    String
  txid      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([playerId])
}
