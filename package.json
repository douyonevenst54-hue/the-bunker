{
  "name": "the-bunker",
  "version": "0.2.0",
  "private": true,
  "description": "THE BUNKER — a free emergency-preparedness game in English and Haitian Creole.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/migrate-deploy.mjs && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "migrate:dev": "prisma migrate dev",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "jose": "6.2.17",
    "next": "16.4.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "prisma": "6.19.3",
    "typescript": "5.9.3"
  }
}
